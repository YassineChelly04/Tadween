{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tadween",
  "version": "1.0.0",
  "identifier": "com.tadween.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tadween",
        "width": 1180,
        "height": 740,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#F4EFE6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; frame-src blob:; child-src blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "resources": {
      "resources/speech/ar/": "speech/ar/",
      "resources/speech/latin/": "speech/latin/"
    },
    "shortDescription": "Encrypted notes for Arabic and Latin writing",
    "longDescription": "Tadween is a local-first notes app. Everything is encrypted on your computer with a key derived from your password.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "French",
          "Arabic"
        ],
        "displayLanguageSelector": true,
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "compression": "lzma",
        "startMenuFolder": "Tadween"
      }
    },
    "publisher": "Yassine Chelly",
    "copyright": "© 2026 Yassine Chelly"
  }
}
